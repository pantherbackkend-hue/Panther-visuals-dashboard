<%- include("../../partials/header", { pageTitle }) %>
<%- include("../partials/layout-start", { activeSection }) %>

<section class="admin-page-head">
  <div>
    <p class="eyebrow">Client management</p>
    <h1>Clients</h1>
    <p class="muted">Manage client profiles and reference materials.</p>
  </div>
  <div class="admin-actions">
    <a class="btn" href="/admin/clients/new">+ New Client</a>
  </div>
</section>

<div class="card admin-panel admin-toolbar">
  <form method="get" action="/admin/clients" class="admin-filter-bar">
    <label style="flex:1;min-width:180px">
      <span class="sr-only">Search</span>
      <input name="q" type="search" placeholder="Search by client name..." value="<%= search || "" %>" />
    </label>
    <button class="btn" type="submit">Search</button>
    <a class="btn btn--outline" href="/admin/clients">Reset</a>
  </form>
</div>

<div class="card admin-panel">
  <% if (clients.length === 0) { %>
    <p class="muted">No clients found. <a href="/admin/clients/new">Create your first client</a>.</p>
  <% } else { %>
    <div style="overflow-x:auto">
      <table class="table" role="table">
        <thead>
          <tr>
            <th scope="col">Client Name</th>
            <th scope="col">Reference Assets</th>
            <th scope="col">Notes</th>
            <th scope="col">Projects</th>
            <th scope="col">Created By</th>
            <th scope="col">Created Date</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% clients.forEach(function(c) { %>
            <tr>
              <td><strong><a class="admin-link" href="/admin/clients/<%= c._id %>"><%= c.name %></a></strong></td>
              <td><%= c.referenceAssets || '<span class="muted">—</span>' %></td>
              <td><%- c.notes ? renderNotes(c.notes) : '<span class="muted">—</span>' %></td>
              <td><%= c.projectCount %></td>
              <td><%= c.createdBy?.name || '<span class="muted">—</span>' %></td>
              <td><%= new Date(c.createdAt).toLocaleDateString("en-IN") %></td>
              <td>
                <div class="admin-actions">
                  <a class="btn btn--small btn--outline" href="/admin/clients/<%= c._id %>">View</a>
                  <a class="btn btn--small btn--outline" href="/admin/clients/<%= c._id %>/edit">Edit</a>
                  <form method="post" action="/admin/clients/<%= c._id %>/delete" class="inline delete-client-form">
                    <button class="btn btn--small btn--danger delete-client-btn" type="button" data-name="<%= c.name %>">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
document.querySelectorAll('.delete-client-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var name = this.getAttribute('data-name');
    if (confirm('Delete client "' + name + '"? This cannot be undone if no projects reference this client.')) {
      this.closest('form').submit();
    }
  });
});
</script>
<%- include("../partials/layout-end") %>
<%- include("../../partials/footer") %>